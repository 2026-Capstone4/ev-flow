{
  "name": "@ev-flow/core",
  "private": true,
  "version": "0.0.0",
  "description": "웹 · RN 앱 공용 코드 (타입 · 판단 함수 · API 호출 · 쿼리 훅 · 화면 데이터 훅). 빌드 없이 소스(.ts)를 그대로 가져다 씀",
  "type": "module",
  "exports": {
    "./app/MapViewProvider": "./src/app/MapViewProvider.tsx",
    "./assets/*": "./src/assets/*",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.5",
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
