# 네이버 지도 JavaScript API Client ID (NCP 콘솔 > Maps > Application)
VITE_NAVER_MAP_CLIENT_ID=

# MSW Mock API 사용 방식
# true    = 전체 Mock. 서버 없이 화면 개발할 때 (Mock 충전소 · 휴게소 · 추천 · 길찾기 · 운영자)
# false   = Mock 사용 안 함. 모든 요청이 실제 서버로 감 (VITE_PROXY_TARGET, 비우면 로컬 백엔드 localhost:8000)
#           운영자 로그인은 실제 서버 계정으로 함 (Mock 계정 MOCK_ADMIN은 true에서만 씀)
VITE_USE_MOCK=true

# API 서버 주소. 비우면 같은 출처의 /api/v1 사용 (예: https://api.example.com/api/v1)
VITE_API_BASE_URL=

# 개발 서버(Vite)가 /api를 넘길 백엔드 주소. 비우면 http://localhost:8000 (예: https://evflowkr.app)
# 브라우저가 서버를 직접 호출하면 CORS에 막히므로 서버 API에 붙일 때는 VITE_API_BASE_URL 대신 이 값을 씀
VITE_PROXY_TARGET=

# 지도 홈 현재 위치 버튼의 GPS 사용 (true = 실제 위치로 이동 · 추천). 시연은 고정 좌표(합정역 근처)로 하므로 기본은 끔
# false여도 버튼은 보이고, 누르면 시연 위치로 지도만 옮김
# HTTPS 주소나 localhost에서만 동작함 (휴대폰에서 http://192.168.x.x 로 열면 위치를 못 받음)
VITE_USE_GEOLOCATION=false
