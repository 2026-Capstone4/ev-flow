# 네이버 지도 JavaScript API Client ID (NCP 콘솔 > Maps > Application)
VITE_NAVER_MAP_CLIENT_ID=

# MSW Mock API 사용 방식
# true    = 전체 Mock. 서버 없이 화면 개발할 때 (Mock 충전소 · 휴게소 · 추천 · 길찾기)
# partial = 백엔드에 아직 없는 API(추천 · 길찾기)만 Mock, 나머지(충전소 · 휴게소)는 실제 서버
#           추천 · 길찾기는 서버의 실제 충전소로 만들고, 예측이 없으면 현재 혼잡도로 채움(source: baseline)
#           실제 서버 요청은 VITE_PROXY_TARGET으로 감 (비우면 로컬 백엔드 localhost:8000)
# false   = Mock 사용 안 함. 모든 요청이 실제 서버로 감
VITE_USE_MOCK=true

# API 서버 주소. 비우면 같은 출처의 /api/v1 사용 (예: https://api.example.com/api/v1)
VITE_API_BASE_URL=

# 개발 서버(Vite)가 /api를 넘길 백엔드 주소. 비우면 http://localhost:8000 (예: http://서버주소)
# 브라우저가 서버를 직접 호출하면 CORS에 막히므로 서버 API에 붙일 때는 VITE_API_BASE_URL 대신 이 값을 씀
VITE_PROXY_TARGET=
