# PostgreSQL 접속 정보 (docker-compose.yml 기본값과 맞춰둠)
DATABASE_URL=postgresql+psycopg2://evflow:evflow@localhost:5432/evflow

# data.go.kr 전기차충전소 정보 API(15076352) 서비스키 (Decoding 키 그대로 사용)
# getChargerStatus, getChargerInfo 둘 다 같은 서비스키 사용
# 마이페이지 > 개발계정 > 활용신청 현황 에서 일반 인증키(Decoding)를 복사해서 붙여넣기
EV_SERVICE_KEY=여기에_서비스키_입력

# 수집 대상 지역 (군구 단위)
TARGET_SIDO=서울특별시
TARGET_GUGUN=광진구
