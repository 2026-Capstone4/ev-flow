# PostgreSQL 접속 정보
# 호스트에서 직접 실행할 때(alembic, scripts/) 쓰는 주소
# 컨테이너 안에서는 compose가 postgres:5432로 덮어쓰므로 신경 쓰지 않아도 됨
DATABASE_URL=postgresql+psycopg2://evflow:DB_비밀번호@localhost:5433/evflow

# postgres 컨테이너 초기화용 - 값이 없으면 compose가 기동을 거부함
# 비밀번호는 영숫자만 사용 (DATABASE_URL 안에 들어가서 기호가 있으면 파싱이 깨짐)
# DATABASE_URL의 비밀번호와 POSTGRES_PASSWORD는 반드시 같은 값이어야 함
POSTGRES_USER=evflow
POSTGRES_PASSWORD=DB_비밀번호
POSTGRES_DB=evflow

# data.go.kr 전기차충전소 정보 API(15076352) 서비스키 (Decoding 키 그대로 사용)
# getChargerStatus, getChargerInfo 둘 다 같은 서비스키 사용
# 마이페이지 > 개발계정 > 활용신청 현황 에서 일반 인증키(Decoding)를 복사해서 붙여넣기
EV_SERVICE_KEY=여기에_서비스키_입력

# 수집 대상 지역 (군구 단위)
TARGET_SIDO=서울특별시
TARGET_GUGUN=광진구
