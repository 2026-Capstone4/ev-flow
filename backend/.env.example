# PostgreSQL 접속 정보
# 호스트에서 직접 실행할 때(alembic, scripts/) 쓰는 주소
# 컨테이너 안에서는 compose가 postgres:5432로 덮어쓰므로 신경 쓰지 않아도 됨
DATABASE_URL=postgresql+psycopg2://evflow:DB_비밀번호@localhost:5433/evflow

# postgres 컨테이너 초기화용 - 값이 없으면 compose가 기동을 거부함
# 비밀번호는 영숫자만 사용 (DATABASE_URL 안에 들어가서 기호가 있으면 파싱이 깨짐)
# DATABASE_URL의 비밀번호와 POSTGRES_PASSWORD는 반드시 같은 값이어야 함
POSTGRES_USER=evflow
POSTGRES_PASSWORD=DB_비밀번호
POSTGRES_DB=evflow

# data.go.kr 전기차충전소 정보 API(15076352) 서비스키 (Decoding 키 그대로 사용)
# getChargerStatus, getChargerInfo 둘 다 같은 서비스키 사용
# 마이페이지 > 개발계정 > 활용신청 현황 에서 일반 인증키(Decoding)를 복사해서 붙여넣기
EV_SERVICE_KEY=여기에_서비스키_입력

# 네이버 Directions 5 (NCP Maps Application ev-flow) - 콘솔 > Application > 인증 정보
# Client ID는 프론트 VITE_NAVER_MAP_CLIENT_ID와 같은 값, Secret은 서버에서만 사용
# 비어 있으면 추천 · 경로의 이동시간을 직선거리로 추정함
NAVER_CLIENT_ID=여기에_Client_ID_입력
NAVER_CLIENT_SECRET=여기에_Client_Secret_입력
# 길찾기 · 추천 호출 제한 - 시연 날 강의실처럼 한 공인 IP를 여럿이 쓰면 올림 (예: 30)
# ROUTE_RATE_LIMIT_PER_MIN=10
# 서버 전체 Directions 실제 호출 예산 / 하루(KST) - 넘으면 길찾기 503, 추천은 직선거리 추정
# DIRECTIONS_DAILY_LIMIT=2000

# 운영자 로그인 JWT 서명 키 (SER-001) - 비어 있으면 로그인만 500, 나머지 API · 수집은 정상
# 생성: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# 바꾸면 기존 로그인이 전부 끊김
JWT_SECRET=

# 로컬에서 http로 화면을 띄워 로그인 쿠키가 저장되지 않으면 false (서버는 HTTPS라 그대로 둠)
# AUTH_COOKIE_SECURE=false

# 로그인 유지 시간 · 실패 제한 - 기본값을 바꿀 때만 주석 해제
# AUTH_TOKEN_TTL_MINUTES=120
# LOGIN_MAX_FAILURES_PER_ID=5
# LOGIN_MAX_FAILURES_PER_IP=20
# LOGIN_FAILURE_WINDOW_SECONDS=900
# LOGIN_LOCK_SECONDS=900
# 추천 모듈(ml) 읽기 전용 접속 - 역할 evflow_ml_reader, 스키마 ml_read (docs/database.md)
# 호스트는 컨테이너 이름 postgres, 비밀번호는 영숫자만 (DSN 파싱이 깨지지 않게)
# 비어 있으면 ml이 시작하지 못함 (collector는 예측만 건너뛰고 수집은 계속함)
EVFLOW_ML_READONLY_DSN=postgresql://evflow_ml_reader:읽기_계정_비밀번호@postgres:5432/evflow
# 체크포인트 producer (docs/prediction.md) - 계산은 evflow_ckpt_reader(읽기 전용), 게시는 evflow_ckpt_writer
# 두 역할의 비밀번호 · LOGIN은 서버에서 직접 설정. 비밀번호는 영숫자만
EVFLOW_CKPT_READER_DSN=postgresql://evflow_ckpt_reader:읽기_계정_비밀번호@postgres:5432/evflow
EVFLOW_CKPT_WRITER_DSN=postgresql://evflow_ckpt_writer:게시_계정_비밀번호@postgres:5432/evflow
# 체크포인트 원천 이름 - 서버는 evflow-prod, 로컬은 비워 두면 evflow-local
# EVFLOW_SOURCE_ID=evflow-prod

# 모델 대기시간을 API 응답에 낼지 - AI v3.1은 빈 충전소도 약 5분으로 나와 v3.2까지 끔 (docs/prediction.md)
# SHOW_WAIT_PREDICTION=true
