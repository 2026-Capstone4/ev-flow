# 앱 환경 변수 예시. 복사해서 .env.local로 쓰고, 값은 커밋하지 않음
# API 주소 (비우면 운영 서버 https://evflowkr.app/api/v1)
EXPO_PUBLIC_API_BASE_URL=
# partial = 추천만 Mock(백엔드에 아직 없음), 나머지는 실제 서버. 비우면 Mock 없이 전부 실제 서버
EXPO_PUBLIC_USE_MOCK=partial
# 네이버 지도 Client ID (웹 VITE_NAVER_MAP_CLIENT_ID와 같은 값). 네이티브 빌드 때 Info.plist에 들어감
NAVER_MAP_CLIENT_ID=
# true = 현재 위치 버튼이 GPS로 위치를 잼. 비우면 시연 위치로 지도만 옮김 (웹 VITE_USE_GEOLOCATION과 같음)
EXPO_PUBLIC_USE_GEOLOCATION=
