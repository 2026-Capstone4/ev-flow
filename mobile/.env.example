# 앱 환경 변수 예시. 복사해서 .env.local로 쓰고, 값은 커밋하지 않음
# API 주소 (비우면 운영 서버 https://evflowkr.app/api/v1)
EXPO_PUBLIC_API_BASE_URL=

# true = 현재 위치 버튼이 GPS로 위치를 잼. 비우면 시연 위치로 지도만 옮김 (웹 VITE_USE_GEOLOCATION과 같음)
# 앱스토어 빌드는 true, 시연 영상 빌드는 비움
EXPO_PUBLIC_USE_GEOLOCATION=

# 시연 위치 = 처음 추천 · 검색 · 길찾기 기준 위치. "위도,경도" 순서, 마포구 안 좌표만 됨 (예: 37.5535,126.9135 합정역 근처)
# 값을 비우거나 쓸 수 없는 값(마포구 밖 · 형식 틀림)을 넣으면 기본 위치(합정역 근처)로 돌아감
# 바꾸면 Release 빌드를 다시 해야 앱에 들어감
EXPO_PUBLIC_DEMO_LOCATION=

# 네이버 지도 Client ID (웹 VITE_NAVER_MAP_CLIENT_ID와 같은 값). 네이티브 빌드 때 Info.plist에 들어감
NAVER_MAP_CLIENT_ID=

# 실기기 빌드 서명용 Apple 개발자 팀 ID (developer.apple.com › Membership). 비우면 시뮬레이터 빌드만 됨
# Mac 키체인의 "Apple Development: …" 인증서 OU 값과 같음 (security find-certificate -c "Apple Development" -p | openssl x509 -noout -subject)
APPLE_TEAM_ID=
