eometry x="955" y="96" width="130" height="1786" as="geometry"/></mxCell><mxCell id="LK" value="카카오&lt;br&gt;길찾기 API" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=0;collapsible=0;size=44;whiteSpace=wrap;html=1;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1145" y="96" width="130" height="1786" as="geometry"/></mxCell><mxCell id="128" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=50;height=22;fillColor=none;fontStyle=1;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="764" width="1410" height="426" as="geometry"/></mxCell><mxCell id="136" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=50;height=22;fillColor=none;fontStyle=1;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="22" y="364" width="1426" height="1164" as="geometry"/></mxCell><mxCell id="141" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=50;height=22;fillColor=none;fontStyle=1;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="22" y="1586" width="1426" height="134" as="geometry"/></mxCell><mxCell id="144" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=50;height=22;fillColor=none;fontStyle=1;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="22" y="1738" width="1426" height="94" as="geometry"/></mxCell><mxCell id="100" value="충전소 추천 Top 3 (REC-001~008, UC-U06, MAP-02)" style="text;html=1;fontStyle=1;fontSize=18;fontFamily=Pretendard;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="770" height="30" as="geometry"/></mxCell><mxCell id="101" value="기준: 후보 제외 · 순위는 AI 패키지 채점 함수(run_recommendation.score_snapshot)를 api 안에서 그대로 부름 (2026-11-22)&lt;br&gt;후보는 마포 충전소만. 지금 출발 · 15분 후 도착 · 30분 후 도착을 한 번에 응답&lt;br&gt;길찾기 결과는 저장하지 않음 (카카오 답변 — 임시 캐싱 금지). 60초 폴링에 넣지 않음" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Pretendard;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="10" width="640" height="70" as="geometry"/></mxCell><mxCell id="102" value="부를 때인지 판단 (core useRecommendationOrigin)&lt;br&gt;· 지도 처음 열 때 · 마지막 추천 후 5분&lt;br&gt;· 기준점에서 500m 넘게 + 2분 · 필터를 바꿔 적용" style="endArrow=block;endFill=1;html=1;align=left;spacingLeft=46;labelBackgroundColor=#ffffff;fontFamily=Pretendard;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="206" as="sourcePoint"/><mxPoint x="260" y="254" as="targetPoint"/><Array as="points"><mxPoint x="300" y="206"/><mxPoint x="300" y="254"/></Array></mxGeometry></mxCell><mxCell id="103" value="POST /api/v1/recommendations {lat, lng, filters} (좌표는 본문)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;labelBackgroundColor=#ffffff;fontFamily=Pretendard;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="284" as="sourcePoint"/><mxPoint x="450" y="284" as="targetPoint"/></mxGeometry></mxCell><mxCell id="104" value="IP당 분당 5회 확인" style="endArrow=block;endFill=1;html=1;align=left;spacingLeft=46;labelBackgroundColor=#ffffff;fontFamily=Pretendard;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="324" as="sourcePoint"/><mxPoint x="450" y="346" as="targetPoint"/><Array as="points"><mxPoint x="490" y="324"/><mxPoint x="490" y="346"/></Array></mxGeometry></mxCell><mxCell id="105" value="[호출 제한 초과]" style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="366" width="180" height="20" as="geometry"/></mxCell><mxCell id="106" value="429 RATE_LIMITED + Retry-After" style="dashed=1;endArrow=open;endFill=0;html=1;verticalAlign=bottom;labelBackgroundColor=#ffffff;fontFamily=Pretendard;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="422" as="sourcePoint"/><mxPoint x="260" y="422" as="targetPoint"/></mxGeometry></mxCe