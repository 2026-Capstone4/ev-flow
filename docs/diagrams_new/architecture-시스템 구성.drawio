<mxfile host="drawio"><diagram id="구성도" name="시스템 구성"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="790" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="EV Flow 시스템 구성 (2026-11-25 기준)" style="text;html=1;fontStyle=1;fontSize=18;fontFamily=Pretendard;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="600" height="30" as="geometry"/></mxCell><mxCell id="memo" value="배포: 맥에서 웹 빌드 → rsync로 서버 frontend/dist · 백엔드는 운영자가 EC2에서 infra/deploy.sh (main 브랜치)&lt;br&gt;AI 패키지(ml/package)는 저장소 · 이미지에 없고 서버에만 둠 — api · ml · producer가 같은 폴더를 읽기 전용 마운트&lt;br&gt;외부에 열린 건 nginx(80 · 443)뿐, 나머지는 Compose 내부 네트워크" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Pretendard;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="10" width="700" height="70" as="geometry"/></mxCell><mxCell id="gc" value="사용자 기기" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="260" height="660" as="geometry"/></mxCell><mxCell id="ios" value="iOS 앱&lt;br&gt;Expo · React Native (App Store 1.0.0)&lt;br&gt;Android는 2026-11-25 시작" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="220" height="70" as="geometry"/></mxCell><mxCell id="web" value="사용자 웹&lt;br&gt;React · Vite (evflowkr.app)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="220" height="56" as="geometry"/></mxCell><mxCell id="adm" value="운영자 대시보드&lt;br&gt;웹 /admin (로그인 쿠키)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="220" height="56" as="geometry"/></mxCell><mxCell id="core" value="packages/core (@ev-flow/core)&lt;br&gt;앱 · 웹 공용 — 타입 · 판단 함수&lt;br&gt;API 호출 · 쿼리 훅" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontFamily=Pretendard;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="220" height="70" as="geometry"/></mxCell><mxCell id="nmap" value="네이버 지도&lt;br&gt;모바일 SDK · JS API" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="220" height="56" as="geometry"/></mxCell><mxCell id="mapapp" value="지도 앱 (네이버 지도 · 카카오맵)&lt;br&gt;딥링크로 운전 안내" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="220" height="56" as="geometry"/></mxCell><mxCell id="ge" value="AWS EC2 t3.small · Docker Compose" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="840" height="660" as="geometry"/></mxCell><mxCell id="ngx" value="nginx :443&lt;br&gt;HTTPS (Let&#x27;s Encrypt)&lt;br&gt;/api 프록시 · 웹 정적 파일" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="160" width="220" height="70" as="geometry"/></mxCell><mxCell id="api" value="api — FastAPI :8000&lt;br&gt;조회 · 추천(AI 채점 함수)&lt;br&gt;길찾기 · 운영자 API" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="160" width="240" height="70" as="geometry"/></mxCell><mxCell id="pkg" value="ml/package (AI 패키지)&lt;br&gt;모델 · 추론 · 채점 코드&lt;br&gt;서버에만 둠" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Pretendard;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="360" y="330" width="220" height="70" as="geometry"/></mxCell><mxCell id="redis" value="Redis 7&lt;br&gt;pred:v2 · pred:raw:v1 · baseline:v1&lt;br&gt;길찾기 예산 · 호출 제한&lt;br&gt;로그인 잠금 · 이용률 집계" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="320" width="190" height="90" as="geometry"/></mxCell><mxCell id="pg" value="PostgreSQL 16&lt;br&gt;충전기 · 상태 로그 · collection_runs&lt;br&gt;admin_users · ml_read · ml_checkpoint" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="490" width="240" height="76" as="geometry"/></mxCell><mxCell id="col" value="collector — APScheduler&lt;br&gt;5분 수집 (마포 · 전국 휴게소 · 서울)&lt;br&gt;04:00 기준선 · 운영 알림" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="490" width="200" height="76" as="geometry"/></mxCell><mxCell id="ml" value="ml :8001 (512MiB)&lt;br&gt;AI 패키지 backend_app&lt;br&gt;혼잡 · 대기 15 · 30분 예측" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="640" width="240" height="70" as="geometry"/></mxCell><mxCell id="prod" value="producer :8002 (384MiB)&lt;br&gt;ml_checkpoint에 체크포인트 게시" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="650" width="200" height="56" as="geometry"/></mxCell><mxCell id="gx" value="외부 서비스" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="110" width="260" height="660" as="geometry"/></mxCell><mxCell id="kakao" value="카카오모빌리티 길찾기&lt;br&gt;다중 목적지 · 자동차 길찾기" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1220" y="167" width="220" height="56" as="geometry"/></mxCell><mxCell id="ndir" value="네이버 Directions 5&lt;br&gt;(설정으로 바꿀 때만)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Pretendard;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="1220" y="260" width="220" height="56" as="geometry"/></mxCell><mxCell id="pub" value="공공데이터포털&lt;br&gt;충전기 운영정보 API&lt;br&gt;getChargerStatus · Info" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1220" y="493" width="220" height="70" as="geometry"/></mxCell><mxCell id="dis" value="Discord Webhook&lt;br&gt;수집 실패 · 지연 알림" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Pretendard;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1220" y="600" width="220" height="56" as="geometry"/></mxCell><mxCell id="e1" value="HTTPS /api/v1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Pretendard;fontSize=12;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="ios" target="ngx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCel